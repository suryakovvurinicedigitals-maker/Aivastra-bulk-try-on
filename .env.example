# Copy to .env (already gitignored by the repo's blanket ".env*" rule) and fill in.

# Merchant dev API key — mint one via POST /v1/merchant/api-keys (session-JWT
# auth, from a logged-in merchant account) or the merchant portal's API Keys
# page. The plaintext is shown exactly once at creation. SECRET — never commit.
DEV_API_KEY=

# https://app.aivastra.com = PRODUCTION, spends real credits. Staging equivalent
# is the staging-admin host (see docs/staging-runbook.md) if you want a dry run
# against non-production data first.
DEV_API_BASE_URL=https://app.aivastra.com

# Optional overrides — defaults are ./input and ./output.
# INPUT_DIR=
# OUTPUT_DIR=

# Optional override for the SQLite store's location (lib/db.mts).
# Default is ./data/bulk-tryon.db.
# BULK_TRYON_DB_PATH=

# How many jobs to have in flight at once. Dev routes are limited to 60 req/min
# per key (create + poll both count), so keep this low.
# CONCURRENCY=2

# How often to poll a job, and how long to wait before giving up on one.
# POLL_INTERVAL_MS=4000
# POLL_TIMEOUT_MS=300000

# Bootstraps the one super admin account for the web control panel
# (webapp/server.mts) on its first run. Optional — if unset, username "admin"
# and a random password are generated and printed once to the server's
# console log (no recovery path after that, only the password hash is
# persisted). The super admin logs in and creates every other account from
# the Users page — there is no self-registration.
#
# SUPERADMIN_PASSWORD stays authoritative after first run too: every restart
# re-checks it against the stored password, and if you've changed it here, the
# stored one is updated to match (and every active session for that account is
# logged out). So to change the super admin password, edit this value and
# restart — or use the Users page instead and leave this line unset/removed,
# but not both, since this value always wins on restart.
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_PASSWORD=
